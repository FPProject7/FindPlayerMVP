{
  "buildSettings": {
    "ENABLE_BITCODE": "NO",
    "IPHONEOS_DEPLOYMENT_TARGET": "14.0",
    "SWIFT_VERSION": "5.0"
  },
  "preBuildScripts": [
    {
      "name": "Install Dependencies and Build IPA",
      "script": "cd $CI_WORKSPACE/frontend && npm ci && npm run build && npx cap sync ios && cd ios/App && pod install --repo-update && cd ../.. && npx cap build ios && cp ios/App/output/App.ipa $CI_WORKSPACE/App.ipa"
    }
  ]
}
