{
  "appId": "co.findplayer.findplayer",
  "appName": "FindPlayer",
  "version": "1.0.1",
  "webDir": "dist",
  "ios": {
    "contentInset": "automatic",
    "webView": {
      "allowsLinkPreview": true,
      "allowsBackForwardNavigationGestures": true
    }
  },
  "android": {
    "path": "./android"
  },
  "plugins": {
    "@capacitor/assets": {
      "iconPath": "src/assets/android_logo.png",
      "splashPath": "src/assets/android_logo.png"
    }
  },
  "server": {
    "allowNavigation": [
      "*.stripe.com",
      "*.stripe.network",
      "*.stripe.dev"
    ]
  }
}
