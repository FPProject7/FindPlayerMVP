{
	"appId": "co.findplayer.app",
	"appName": "FindPlayer",
	"webDir": "dist",
	"ios": {
		"contentInset": "automatic",
		"webView": {
			"allowsLinkPreview": true,
			"allowsBackForwardNavigationGestures": true
		},
		"limitsNavigationsToAppBoundDomains": false
	},
	"android": {
		"path": "./android"
	},
	"plugins": {
		"@capacitor/assets": {
			"iconPath": "src/assets/android_logo.png",
			"splashPath": "src/assets/android_logo.png"
		}
	},
	"server": {
		"allowNavigation": [
			"*.stripe.com",
			"*.stripe.network",
			"*.stripe.dev"
		]
	}
}
